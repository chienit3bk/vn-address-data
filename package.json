{
  "name": "vn-address-data",
  "version": "1.0.0",
  "description": "Dữ liệu hành chính VN (34 tỉnh) + thư viện format & dropdown Tỉnh/Phường-Xã. Nguồn: Nhất Tín (ntlogistics.vn).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": { "node": ">=20" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./data/*": "./data/*",
    "./package.json": "./package.json"
  },
  "files": ["dist", "data", "src"],
  "repository": {
    "type": "git",
    "url": "https://github.com/chienit3bk/vn-address-data.git"
  },
  "homepage": "https://github.com/chienit3bk/vn-address-data#readme",
  "scripts": {
    "prepare": "tsc -p tsconfig.build.json",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test src/*.test.ts",
    "check": "yarn typecheck && yarn test",
    "demo": "tsc -p tsconfig.build.json && serve . --no-clipboard"
  },
  "keywords": ["vietnam", "address", "province", "ward", "nhat-tin", "ntlogistics", "34-tinh"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.7.0",
    "serve": "^14.2.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
